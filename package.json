{
  "name": "local-agent-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "build": "vite build",
    "build:pages": "vite build && node scripts/prepare-pages.ts",
    "test:upgrade": "node --disable-warning=ExperimentalWarning scripts/upgrade-check.ts",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "probe": "node --disable-warning=ExperimentalWarning scripts/probe.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
