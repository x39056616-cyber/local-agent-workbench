{
  "name": "local-agent-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "build": "vite build",
    "build:pages": "vite build && node scripts/prepare-pages.ts",
    "test:upgrade": "node --disable-warning=ExperimentalWarning scripts/upgrade-check.ts",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "probe": "node --disable-warning=ExperimentalWarning scripts/probe.ts",
    "test:mechanisms": "node scripts/mechanisms-check.ts",
    "test:optimization": "node scripts/optimization-check.ts"
  },
  "dependencies": {
    "@crawlee/basic": "3.18.2",
    "@crawlee/core": "3.18.2",
    "cheerio": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "robots-parser": "3.0.1",
    "undici": "^8.12.3",
    "word-extractor": "1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.14.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
